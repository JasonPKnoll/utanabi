# Env vars read by the server-mode build only (task build:server). Desktop and mobile builds ignore them.

# Address the HTTP server binds to. Keep localhost and put a TLS reverse proxy in front in production.
WAILS_SERVER_HOST=localhost

# Port the HTTP server listens on. Default 8080.
WAILS_SERVER_PORT=8080

# Folder for the SQLite database. Default ./data.
UTANABI_DATA_DIR=./data

# Folder that holds settings.json. Defaults to UTANABI_DATA_DIR.
UTANABI_CONFIG_DIR=

# debug, info, warn, or error. Overrides log_level in settings.json. Default info.
UTANABI_LOG_LEVEL=info

# How long a database statement waits for a lock, as a Go duration. Default 5s.
UTANABI_DB_BUSY_TIMEOUT=5s

# Comma-separated public origins a reverse proxy serves the app from, for example https://utanabi.example.com.
# The request's own host is always allowed. A bare * is rejected.
UTANABI_ALLOWED_ORIGINS=
