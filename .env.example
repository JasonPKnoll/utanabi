# Env vars read by the server-mode build only (task build:server). Desktop and mobile builds ignore them.

# Address the HTTP server binds to. Keep localhost and put a TLS reverse proxy in front in production.
WAILS_SERVER_HOST=localhost

# Port the HTTP server listens on. Default 8080.
WAILS_SERVER_PORT=8080

# Folder for the SQLite database. Default ./data.
UTANABI_DATA_DIR=./data

# Folder that holds settings.json. Defaults to UTANABI_DATA_DIR.
UTANABI_CONFIG_DIR=

# debug, info, warn, or error. Overrides log_level in settings.json. Default info.
UTANABI_LOG_LEVEL=info

# How long a database statement waits for a lock, as a Go duration. Default 5s.
UTANABI_DB_BUSY_TIMEOUT=5s

# The read-only reference dictionary that task dictionary builds. A relative path is taken from UTANABI_DATA_DIR.
# Without the file the app still runs, with word meanings unavailable. Default: dictionary.db in UTANABI_DATA_DIR.
UTANABI_DICTIONARY_PATH=

# Comma-separated public origins a reverse proxy serves the app from, for example https://utanabi.example.com.
# The request's own host is always allowed. A bare * is rejected.
UTANABI_ALLOWED_ORIGINS=

# The online lyrics sources, comma-separated: lrclib, which song search asks for lyrics, and amll, the AMLL TTML DB of
# songs timed word by word, which a synced song's word times are looked up in. "none" turns them all off, and then
# nothing is sent to any lyrics service. Overrides lyrics_sources in settings.json. Default: lrclib,amll.
UTANABI_LYRICS_SOURCES=lrclib,amll

# A sign-up code anyone can make an account with, at least 12 characters, alongside the one-use invites admins make
# in the app. Unset means only invites work. Make an admin with: go run ./cmd/admin -grant <username>
UTANABI_SIGNUP_CODE=

# Spotify, for following along: the client ID of an app on Spotify's developer dashboard
# (developer.spotify.com/dashboard), with each address it's reached at registered as a redirect URI, such as
# https://<host>/auth/spotify/callback. It isn't a secret: the app signs in with PKCE and keeps no client secret.
# Unset means Spotify is off. Development-mode apps work for up to five allow-listed Spotify accounts.
UTANABI_SPOTIFY_CLIENT_ID=

# YouTube, for playing a song's video in the page: an API key for the YouTube Data API v3 (Google Cloud console,
# APIs & Services, Credentials), so the app can search for each song's video. It's a secret; keep it on the server.
# The free quota covers about 100 searches a day, and each song is searched once. Unset means no search: you paste
# a YouTube link for each song instead, and the video still plays. An admin can instead enter the key in Settings,
# or run make youtube-key, which keeps it sealed in the database; that key is used over this one.
UTANABI_YOUTUBE_API_KEY=

# How many right answers in a row make a flashcard count as learned, from 1 to 10. Overrides study_streak in
# settings.json. Default: 3.
UTANABI_STUDY_STREAK=3

# The admins' song tools, for testing: finding songs that have word times, and removing a song from every library on
# the server to add it again fresh. on or off. Default: off.
UTANABI_SONG_TOOLS=off
