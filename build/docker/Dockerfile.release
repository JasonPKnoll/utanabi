# The Utanabi server image: the server-mode build, with the dictionary built in, on a minimal base. Use it from any
# browser, phone included. Build it after building the frontend (frontend/dist, embedded in the binary) and copying
# dictionary.db into internal/dictionary/bundled, as the Release workflow does:
#
#   docker buildx build -f build/docker/Dockerfile.release --build-arg VERSION=0.1.0 -t utanabi .
#
# Run it with a volume for your data, and the settings in .env.example:
#
#   docker run -p 8080:8080 -v utanabi:/data -e UTANABI_SIGNUP_CODE=... ghcr.io/jasonpknoll/utanabi
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN test -f frontend/dist/index.html || { echo "build the frontend first: frontend/dist is missing" >&2; exit 1; }
RUN test -f internal/dictionary/bundled/dictionary.db || { echo "copy dictionary.db into internal/dictionary/bundled first" >&2; exit 1; }
# Pure Go throughout (SQLite included), so it cross-compiles for each platform without emulation.
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -tags server,production,bundled_dictionary -trimpath \
      -buildvcs=false -ldflags="-s -w -X github.com/JasonPKnoll/utanabi/internal/config.version=${VERSION}" \
      -o /out/utanabi-server . \
    && mkdir -p /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/utanabi-server /utanabi-server
COPY --from=builder --chown=nonroot:nonroot /out/data /data
ENV WAILS_SERVER_HOST=0.0.0.0 \
    WAILS_SERVER_PORT=8080 \
    UTANABI_DATA_DIR=/data
VOLUME /data
EXPOSE 8080
ENTRYPOINT ["/utanabi-server"]
