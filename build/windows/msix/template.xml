<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="utanabi"
        Arguments=""
        InstallLocation="C:\Program Files\Jason Knoll\Utanabi">
    </Installer>
    <PackageInformation
        PackageName="Utanabi"
        PackageDisplayName="Utanabi"
        PublisherName="CN=Jason Knoll"
        PublisherDisplayName="Jason Knoll"
        Version="0.1.0.0"
        PackageDescription="Learn Japanese through song lyrics">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.jasonpknoll.utanabi"
                Description="Learn Japanese through song lyrics"
                DisplayName="Utanabi"
                ExecutableName="utanabi"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Utanabi</DisplayName>
            <PublisherDisplayName>Jason Knoll</PublisherDisplayName>
            <Description>Learn Japanese through song lyrics</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="utanabi.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
